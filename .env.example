# ==============================================================================
# Nivara AI — Environment Configuration
# ==============================================================================

# Application & Security
PROJECT_NAME="Nivara AI"
VERSION="1.1.0"
API_V1_STR="/api"
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Allowed Origins (Comma-separated list of origins permitted to access API)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Frontend API URL (Configured in frontend/.env or runtime)
# VITE_API_URL="https://api.nivara.ac.in/api"

# Database Configuration (Supabase PostgreSQL 16 / asyncpg)
#
# Option A: Supabase Session Pooler (IPv4 / Render Recommended - Port 5432)
# DATABASE_URL="postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Option B: Supabase Direct Connection (Requires IPv6 or Addon - Port 5432)
# DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
#
# Option C: Supabase Transaction Pooler (Port 6543 - statement_cache_size=0 enabled automatically)
# DATABASE_URL="postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
#
# Local Offline Development Default:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nivara"

# PostgreSQL / Supabase TLS & Certificate Verification
# Enforced automatically for remote/Supabase hosts using system CA bundle
DB_SSL_REQUIRED=true

# Connection Pool Tuning (optimized for Supabase & Render)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=10

# Privacy & Session Configuration
# Anonymous student conversation transcripts and audio recordings are NOT persisted by default.
ANONYMOUS_SESSION_TTL_MINUTES=60
