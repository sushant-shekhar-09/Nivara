# ==============================================================================
# Nivara AI — Environment Configuration
# ==============================================================================

# Application & Security
PROJECT_NAME="Nivara AI"
VERSION="1.1.0"
API_V1_STR="/api"
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Allowed Origins (Comma-separated list of origins permitted to access API)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Frontend API URL (Configured in frontend/.env or runtime)
# VITE_API_URL="https://api.nivara.ac.in/api"

# Database (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nivara"

# Privacy & Session Configuration
# Anonymous student conversation transcripts and audio recordings are NOT persisted by default.
ANONYMOUS_SESSION_TTL_MINUTES=60
